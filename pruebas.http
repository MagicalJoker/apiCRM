############################################################
# DEPARTAMENTO
############################################################

### 1. Crear Departamento (POST)
POST http://localhost:8080/api/departamentos
Content-Type: application/json

{
  "codigo": "INF",
  "nombre": "Informática",
  "descripcion": "Departamento de Informática",
  "telefono": "958000001"
}

### 2. Consultar Todos los Departamentos (GET)
GET http://localhost:8080/api/departamentos

### 3. Actualizar Departamento (PUT)
PUT http://localhost:8080/api/departamentos/1
Content-Type: application/json

{
  "codigo": "INF",
  "nombre": "Informática y Comunicaciones",
  "descripcion": "Departamento actualizado",
  "telefono": "958000002"
}

### 4. Probar Código Duplicado (POST)
POST http://localhost:8080/api/departamentos
Content-Type: application/json

{
  "codigo": "INF",
  "nombre": "Otro Departamento",
  "descripcion": "Debe fallar por código duplicado",
  "telefono": "958000003"
}

### 5. Eliminar Departamento (DELETE)
DELETE http://localhost:8080/api/departamentos/1


