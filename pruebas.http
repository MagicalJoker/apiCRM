############################################################
# TITULACION
############################################################

### 1. Crear Titulación (POST)
POST http://localhost:8080/api/titulaciones
Content-Type: application/json

{
  "codigo": "77889900",
  "diminutivo": "DAW",
  "horasTotales": 2000
}

### 2. Consultar Todas las Titulaciones (GET)
GET http://localhost:8080/api/titulaciones

### 3. Actualizar Titulación (PUT)
PUT http://localhost:8080/api/titulaciones/1
Content-Type: application/json

{
  "codigo": "77889900",
  "diminutivo": "DAW",
  "horasTotales": 2100
}

### 4. Probar Código Duplicado (POST)
POST http://localhost:8080/api/titulaciones
Content-Type: application/json

{
  "codigo": "77889900",
  "diminutivo": "ASIR",
  "horasTotales": 2000
}

### 5. Eliminar Titulación (DELETE)
DELETE http://localhost:8080/api/titulaciones/1


############################################################
# CURSO
############################################################

### 1. Crear Curso (POST)
POST http://localhost:8080/api/cursos
Content-Type: application/json

{
  "diminutivo": "CSI 1",
  "descripcion": "Primer curso de DAW",
  "titulacion": {
    "idTitulacion": 1
  }
}

### 2. Consultar Todos los Cursos (GET)
GET http://localhost:8080/api/cursos

### 3. Actualizar Curso (PUT)
PUT http://localhost:8080/api/cursos/1
Content-Type: application/json

{
  "diminutivo": "CSI 1",
  "descripcion": "Primer curso de DAW actualizado",
  "titulacion": {
    "idTitulacion": 1
  }
}

### 4. Probar Diminutivo Duplicado (POST)
POST http://localhost:8080/api/cursos
Content-Type: application/json

{
  "diminutivo": "CSI 1",
  "descripcion": "Debe fallar por diminutivo duplicado",
  "titulacion": {
    "idTitulacion": 1
  }
}

### 5. Eliminar Curso (DELETE)
DELETE http://localhost:8080/api/cursos/1
